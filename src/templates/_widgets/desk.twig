{# Four numbers and the oldest unanswered tickets.

   Deliberately not a chart: somebody opening the control panel in the morning wants to know
   whether anything is on fire, and a sparkline of last month's volume does not answer that. #}
<div class="csr-tiles">
    {% set tiles = [
        { label: 'Open'|t('csr'), value: counts.open, url: url('csr/tickets') },
        { label: 'No reply yet'|t('csr'), value: counts.awaitingFirstResponse, url: url('csr/tickets') },
        { label: 'Unassigned'|t('csr'), value: counts.unassigned, url: url('csr/tickets') },
        { label: 'Late'|t('csr'), value: counts.breaching, url: url('csr/tickets'), alert: true },
    ] %}

    {% for tile in tiles %}
        <a href="{{ tile.url }}" class="csr-tile">
            <div class="csr-tile-value {{ tile.alert ?? false and tile.value > 0 ? 'error' }}">{{ tile.value }}</div>
            <div class="csr-tile-label light">{{ tile.label }}</div>
        </a>
    {% endfor %}
</div>

{% if tickets|length %}
    <h5 class="heading light">{{ 'Waiting longest'|t('csr') }}</h5>
    <ul class="csr-waiting">
        {% for ticket in tickets %}
            <li>
                <a href="{{ ticket.cpEditUrl }}">
                    <span class="status {{ ticket.priorityColor }}"></span>#{{ ticket.number }} {{ ticket.title }}
                </a>
                <span class="light">{{ ticket.submittedAt ? ticket.submittedAt|timestamp('short') : '' }}</span>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p class="light">{{ mineOnly ? 'Nothing is waiting on you.'|t('csr') : 'Every ticket has been answered.'|t('csr') }}</p>
{% endif %}
