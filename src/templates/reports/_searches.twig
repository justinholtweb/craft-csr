{% extends '_layouts/cp' %}
{% set title = 'Searches'|t('csr') %}
{% set selectedSubnavItem = 'reports' %}
{% set selectedReport = 'searches' %}

{% macro table(rows, emptyMessage) %}
    {% if rows|length %}
        <table class="data fullwidth" style="margin-top: 12px;">
            <thead>
                <tr>
                    <th scope="col">{{ 'Search'|t('csr') }}</th>
                    <th scope="col">{{ 'Times'|t('csr') }}</th>
                    <th scope="col">{{ 'Empty'|t('csr') }}</th>
                    <th scope="col">{{ 'Opened something'|t('csr') }}</th>
                    <th scope="col">{{ 'Last seen'|t('csr') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td><strong>{{ row.query }}</strong></td>
                        <td>{{ row.searches }}</td>
                        <td class="{{ row.noResults > 0 ? 'error' : 'light' }}">{{ row.noResults }}</td>
                        <td>{{ row.clicks }}</td>
                        <td class="light">{{ row.lastSearched|datetime('short') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="light">{{ emptyMessage }}</p>
    {% endif %}
{% endmacro %}

{% block content %}
    {% include 'csr/_partials/_report-nav' %}

    {% if canExport %}
        <p style="margin-bottom: 16px;">
            <a href="{{ url('csr/reports/export-searches', { days: days, siteId: siteId }) }}" class="btn">{{ 'Export every search'|t('csr') }}</a>
            <span class="light">{{ 'The failed ones are a work list, and work lists get assigned to people in spreadsheets.'|t('csr') }}</span>
        </p>
    {% endif %}

    <div class="pane" style="margin-bottom: 24px;">
        <h2>{{ 'Came back with nothing'|t('csr') }}</h2>
        <p class="light">{{ 'In the order they are worth writing. `resultCount = 0`, not “few results” — a thin result set is a ranking problem, an empty one is a missing page, and mixing them makes a list nobody can act on.'|t('csr') }}</p>

        {% if not available %}
            {% include 'csr/_partials/_pro' with {
                heading: 'Failed-search analytics'|t('csr'),
                body: 'This report is the reason to buy Pro. Everything below the fold on this screen comes with it.'|t('csr'),
            } only %}
        {% else %}
            {{ _self.table(failed, 'Nothing came back empty in this window.'|t('csr')) }}
        {% endif %}
    </div>

    {% if available %}
        <div class="pane" style="margin-bottom: 24px;">
            <h2>{{ 'Found something, and nobody opened it'|t('csr') }}</h2>
            <p class="light">{{ 'A different failure, and often more interesting: the knowledge base has something to say and the title is not convincing anybody to click. Usually a wording problem, not a missing article.'|t('csr') }}</p>
            {{ _self.table(unclicked, 'Nothing to report here.'|t('csr')) }}
        </div>
    {% endif %}

    <div class="pane">
        <h2>{{ 'Most searched'|t('csr') }}</h2>
        <p class="light">{{ 'What your customers are actually trying to do, in their own words.'|t('csr') }}</p>
        {{ _self.table(top, 'Nobody has searched yet.'|t('csr')) }}
    </div>
{% endblock %}
