{% extends '_layouts/cp' %}
{% set title = 'The desk'|t('csr') %}
{% set selectedSubnavItem = 'reports' %}
{% set selectedReport = 'desk' %}

{% block content %}
    {% include 'csr/_partials/_report-nav' %}

    {% if not available %}
        {% include 'csr/_partials/_pro' with {
            heading: 'Desk reports'|t('csr'),
            body: 'Pro reports ticket volume, first-response and resolution times, who is carrying what, and what customers said afterwards.'|t('csr'),
        } only %}
    {% else %}
        {% macro duration(minutes) %}
            {% if minutes is null %}—
            {% elseif minutes < 60 %}{{ '{n} min'|t('csr', { n: minutes|round }) }}
            {% elseif minutes < 1440 %}{{ '{n} hrs'|t('csr', { n: (minutes / 60)|round(1) }) }}
            {% else %}{{ '{n} days'|t('csr', { n: (minutes / 1440)|round(1) }) }}
            {% endif %}
        {% endmacro %}

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; margin-bottom: 24px;">
            {% set tiles = [
                { label: 'Raised'|t('csr'), value: summary.raised|number },
                { label: 'Resolved'|t('csr'), value: summary.resolved|number },
                { label: 'Still open'|t('csr'), value: summary.open|number },
                { label: 'Awaiting a first reply'|t('csr'), value: summary.backlog|number },
                { label: 'Median first reply'|t('csr'), value: _self.duration(summary.firstResponseMinutes) },
                { label: 'Median resolution'|t('csr'), value: _self.duration(summary.resolutionMinutes) },
            ] %}

            {% for tile in tiles %}
                <div class="pane">
                    <h5 class="heading light">{{ tile.label }}</h5>
                    <div style="font-size: 26px; line-height: 1.1;">{{ tile.value }}</div>
                </div>
            {% endfor %}
        </div>

        <div class="pane" style="margin-bottom: 24px;">
            <h2>{{ 'Promises kept'|t('csr') }}</h2>
            <p class="light">{{ 'First response and resolution are counted separately, because breaching them means different things: the first is nearly always the desk’s, the second frequently is not.'|t('csr') }}</p>

            <table class="data fullwidth" style="margin-top: 12px;">
                <tbody>
                    <tr>
                        <th scope="row">{{ 'First response missed'|t('csr') }}</th>
                        <td class="{{ summary.firstResponseBreaches > 0 ? 'error' }}">{{ summary.firstResponseBreaches }}</td>
                    </tr>
                    <tr>
                        <th scope="row">{{ 'Resolution missed'|t('csr') }}</th>
                        <td class="{{ summary.resolutionBreaches > 0 ? 'error' }}">{{ summary.resolutionBreaches }}</td>
                    </tr>
                    <tr>
                        <th scope="row">{{ 'Average satisfaction'|t('csr') }}</th>
                        <td>
                            {% if summary.satisfaction %}
                                {{ summary.satisfaction|number_format(2) }} / 5
                                <span class="light">({{ '{n} responses'|t('csr', { n: summary.satisfactionCount }) }})</span>
                            {% else %}
                                <span class="light">{{ 'Nobody has rated a ticket yet.'|t('csr') }}</span>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="pane" style="margin-bottom: 24px;">
            <h2>{{ 'Who is carrying what'|t('csr') }}</h2>
            {% if workload|length %}
                <table class="data fullwidth" style="margin-top: 12px;">
                    <thead><tr><th>{{ 'Agent'|t('csr') }}</th><th>{{ 'Open'|t('csr') }}</th><th>{{ 'Resolved'|t('csr') }}</th><th>{{ 'Rating'|t('csr') }}</th></tr></thead>
                    <tbody>
                        {% for row in workload %}
                            <tr>
                                <td>{{ row.name }}</td>
                                <td>{{ row.open }}</td>
                                <td>{{ row.resolved }}</td>
                                <td>{{ row.satisfaction ? row.satisfaction ~ ' / 5' : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="light">{{ 'Nothing is assigned to anybody.'|t('csr') }}</p>
            {% endif %}
        </div>

        <div class="pane">
            <h2>{{ 'Tickets a day'|t('csr') }}</h2>
            {% set max = trend|length ? max(trend) : 0 %}
            {% if max > 0 %}
                {# A bar chart made of divs. A charting library on one control panel screen is a
                   dependency to maintain forever in exchange for rounded corners. #}
                <div style="display: flex; align-items: flex-end; gap: 2px; height: 120px; margin-top: 16px;">
                    {% for day, count in trend %}
                        <div title="{{ day }}: {{ count }}"
                             style="flex: 1; min-width: 2px; background: var(--primary-color, #0b69a3); opacity: {{ count > 0 ? 0.85 : 0.15 }}; height: {{ max > 0 ? (count / max * 100)|round : 0 }}%;"></div>
                    {% endfor %}
                </div>
                <p class="light" style="margin-top: 8px;">{{ 'Peak: {n} in a day'|t('csr', { n: max }) }}</p>
            {% else %}
                <p class="light">{{ 'No tickets in this window.'|t('csr') }}</p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
