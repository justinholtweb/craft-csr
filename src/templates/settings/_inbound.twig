{% extends 'csr/settings/_layout' %}
{% import '_includes/forms' as forms %}
{% set title = 'Inbound email'|t('csr') %}

{% block settings %}
    {% if not allowsInbound %}
        {% include 'csr/_partials/_pro' with {
            heading: 'Inbound email'|t('csr'),
            body: 'Pro turns email into tickets: point Postmark, Mailgun or SendGrid at CSR, or let it read a mailbox, and new messages raise tickets while replies land on the ticket they answer — with quoted history and signatures cut off, attachments kept, and auto-replies ignored.'|t('csr'),
        } only %}
    {% else %}
        <div class="readable">
            <p class="light">{{ 'New email raises a ticket; a reply lands on the ticket it answers. Every email CSR sends a customer carries a reply address with a tag that belongs to their ticket — support+k3v9…@example.com — and that tag is how the reply finds its way back. Quoted history and signatures are cut off, HTML is turned into text, and out-of-office replies, bounces and mailing lists are ignored.'|t('csr') }}</p>
        </div>

        {{ forms.lightswitchField({
            label: 'Take tickets by email'|t('csr'),
            name: 'settings[inboundEnabled]',
            on: settings.inboundEnabled,
        }) }}

        {{ forms.autosuggestField({
            label: 'The desk’s address'|t('csr'),
            instructions: 'Where customers write to, and the base of every reply address — `support@example.com` becomes `support+<tag>@example.com`. Your provider must deliver plus-addressed mail for it (all of the big ones do). An environment variable works too.'|t('csr'),
            name: 'settings[inboundAddress]',
            value: settings.inboundAddress,
            suggestEnvVars: true,
            errors: settings.getErrors('inboundAddress'),
        }) }}

        {{ forms.lightswitchField({
            label: 'Raise a ticket for new email'|t('csr'),
            instructions: 'Off, only replies to existing tickets are taken; everything else is refused and logged.'|t('csr'),
            name: 'settings[inboundCreateTickets]',
            on: settings.inboundCreateTickets,
        }) }}

        {{ forms.selectField({
            label: 'A reply from somebody other than the ticket’s customer'|t('csr'),
            instructions: 'The reply address is in every email the customer was sent, so it can be forwarded. Mail from anybody else never joins their conversation.'|t('csr'),
            name: 'settings[inboundUnverifiedSender]',
            value: settings.inboundUnverifiedSender,
            options: [
                { label: 'Raise it as a new ticket'|t('csr'), value: 'newTicket' },
                { label: 'Refuse it'|t('csr'), value: 'reject' },
            ],
        }) }}

        {{ forms.textField({
            label: 'Emails one sender may send per hour'|t('csr'),
            instructions: 'Zero is unlimited. The rest are dropped and logged — a mail loop with somebody else’s system is the usual reason this is ever reached.'|t('csr'),
            name: 'settings[inboundRateLimit]',
            value: settings.inboundRateLimit,
            type: 'number',
            size: 5,
        }) }}

        {{ forms.lightswitchField({
            label: 'Keep attachments'|t('csr'),
            instructions: attachmentsReady
                ? 'Under the support form’s attachment rules — the same volume, file types, size and count. A file whose content does not match its extension is refused, and the agent sees a note saying what was not kept.'|t('csr')
                : 'Attachments are switched off on the Support form screen, so files that arrive by email are not kept. Turn them on and choose a volume there first.'|t('csr'),
            name: 'settings[inboundAttachments]',
            on: settings.inboundAttachments,
        }) }}

        {{ forms.textareaField({
            label: 'Other addresses the desk sends from'|t('csr'),
            instructions: 'Mail *from* these is never turned into a ticket. The desk’s address and Craft’s own sending address are always included.'|t('csr'),
            name: 'settings[inboundIgnoreAddresses]',
            value: settings.inboundIgnoreAddresses,
            rows: 2,
            class: 'code',
        }) }}

        <hr>

        <h2>{{ 'Provider webhooks'|t('csr') }}</h2>

        <div class="readable">
            <p class="light">{{ 'Point your provider’s inbound route at its URL below. Every delivery is verified before it is read, and a provider with nothing set here is refused outright. The answer goes back as soon as the email is stored; the ticket is made by a queue job.'|t('csr') }}</p>
        </div>

        <h3>Postmark</h3>
        <p class="light">{{ 'Postmark does not sign inbound mail; it authenticates with credentials in the webhook URL. Set a username and password here and enter the URL as https://username:password@… in Postmark.'|t('csr') }}</p>
        <p><code>{{ webhooks.postmark }}</code></p>
        <div class="flex-fields">
            {{ forms.autosuggestField({ label: 'Username'|t('csr'), name: 'settings[postmarkUsername]', value: settings.postmarkUsername, suggestEnvVars: true }) }}
            {{ forms.autosuggestField({ label: 'Password'|t('csr'), name: 'settings[postmarkPassword]', value: settings.postmarkPassword, suggestEnvVars: true }) }}
        </div>

        <h3>Mailgun</h3>
        <p class="light">{{ 'A route with the forward() action to this URL. Every post is signed with your HTTP webhook signing key, and CSR refuses a stale timestamp or a token it has seen before.'|t('csr') }}</p>
        <p><code>{{ webhooks.mailgun }}</code></p>
        {{ forms.autosuggestField({ label: 'HTTP webhook signing key'|t('csr'), name: 'settings[mailgunSigningKey]', value: settings.mailgunSigningKey, suggestEnvVars: true }) }}

        <h3>SendGrid</h3>
        <p class="light">{{ 'Inbound Parse to this URL. Preferred: attach a security policy with signature verification and paste its public key here — the webhook must then be served with PHP’s enable_post_data_reading = Off, because PHP otherwise discards the raw body the signature covers. Otherwise use basic-auth credentials in the Parse URL.'|t('csr') }}</p>
        <p><code>{{ webhooks.sendgrid }}</code></p>
        {{ forms.autosuggestField({ label: 'Signature public key'|t('csr'), name: 'settings[sendgridPublicKey]', value: settings.sendgridPublicKey, suggestEnvVars: true }) }}
        <div class="flex-fields">
            {{ forms.autosuggestField({ label: 'Username'|t('csr'), name: 'settings[sendgridUsername]', value: settings.sendgridUsername, suggestEnvVars: true }) }}
            {{ forms.autosuggestField({ label: 'Password'|t('csr'), name: 'settings[sendgridPassword]', value: settings.sendgridPassword, suggestEnvVars: true }) }}
        </div>

        {{ forms.textField({
            label: 'Replay window'|t('csr'),
            instructions: 'Seconds either side of now a signed timestamp may be (Mailgun, SendGrid).'|t('csr'),
            name: 'settings[inboundReplayWindow]',
            value: settings.inboundReplayWindow,
            type: 'number',
            size: 5,
            errors: settings.getErrors('inboundReplayWindow'),
        }) }}

        <hr>

        <h2>{{ 'A mailbox instead (IMAP)'|t('csr') }}</h2>

        {% if not imapAvailable %}
            <div class="readable csr-callout">
                <p class="light">{{ 'PHP’s imap extension is not installed on this server, so CSR cannot read a mailbox. A provider webhook above needs nothing extra — or install the extension (PECL “imap” on PHP 8.4+).'|t('csr') }}</p>
            </div>
        {% endif %}

        <p class="light">{{ 'Run php craft csr/inbound/poll from cron every few minutes. Unread messages are taken in and then marked read, or deleted.'|t('csr') }}</p>

        <div class="flex-fields">
            {{ forms.autosuggestField({ label: 'Host'|t('csr'), name: 'settings[imapHost]', value: settings.imapHost, suggestEnvVars: true }) }}
            {{ forms.textField({ label: 'Port'|t('csr'), name: 'settings[imapPort]', value: settings.imapPort, type: 'number', size: 6 }) }}
            {{ forms.selectField({
                label: 'Encryption'|t('csr'),
                name: 'settings[imapEncryption]',
                value: settings.imapEncryption,
                options: [{ label: 'SSL', value: 'ssl' }, { label: 'STARTTLS', value: 'tls' }, { label: 'None'|t('csr'), value: 'none' }],
            }) }}
        </div>
        <div class="flex-fields">
            {{ forms.autosuggestField({ label: 'Username'|t('csr'), name: 'settings[imapUsername]', value: settings.imapUsername, suggestEnvVars: true }) }}
            {{ forms.autosuggestField({ label: 'Password'|t('csr'), name: 'settings[imapPassword]', value: settings.imapPassword, suggestEnvVars: true }) }}
            {{ forms.textField({ label: 'Mailbox'|t('csr'), name: 'settings[imapMailbox]', value: settings.imapMailbox }) }}
        </div>
        {{ forms.selectField({
            label: 'Afterwards'|t('csr'),
            name: 'settings[imapAfterImport]',
            value: settings.imapAfterImport,
            options: [
                { label: 'Mark the message read'|t('csr'), value: 'seen' },
                { label: 'Delete the message'|t('csr'), value: 'delete' },
            ],
        }) }}

        {% if recent|length %}
            <hr>
            <h2>{{ 'The last emails received'|t('csr') }}</h2>
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Received'|t('csr') }}</th>
                        <th scope="col">{{ 'From'|t('csr') }}</th>
                        <th scope="col">{{ 'Via'|t('csr') }}</th>
                        <th scope="col">{{ 'Became'|t('csr') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in recent %}
                        <tr>
                            <td>{{ row.dateCreated|datetime('short') }}</td>
                            <td>{{ row.fromEmail }}</td>
                            <td>{{ row.provider }}</td>
                            <td>
                                {% if row.ticketId %}<a href="{{ url('csr/tickets/' ~ row.ticketId) }}">{{ row.status }}</a>{% else %}{{ row.status }}{% endif %}
                                {% if row.reason %}<span class="light">— {{ row.reason }}</span>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endif %}
{% endblock %}
